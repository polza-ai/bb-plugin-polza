{
  "name": "bb-plugin-polza",
  "version": "0.1.0",
  "description": "Polza.ai provider for bb: sign in with Polza, pick catalog models, see your balance.",
  "license": "MIT",
  "type": "module",
  "engines": {
    "bb": ">=0.49",
    "bbPluginSdk": ">=0.6.132"
  },
  "bb": {
    "name": "Polza [Experimental]",
    "description": "Run bb threads on polza.ai models with Claude Code: OAuth sign-in, a curated model list, balance and ruble spend.",
    "branding": {
      "icon": "./icons/polza.svg"
    },
    "server": "./server.ts",
    "app": "./app.tsx",
    "host": "./src/host.ts",
    "skills": ["skills"],
    "experimental_providers": [
      {
        "kind": "agent",
        "id": "polza",
        "displayName": "Polza"
      }
    ]
  },
  "keywords": ["bb-plugin", "polza", "llm", "provider"],
  "scripts": {
    "build": "bb plugin build",
    "test": "vitest run",
    "typecheck": "tsc --noEmit"
  },
  "dependencies": {
    "@anthropic-ai/claude-agent-sdk": "^0.3.318",
    "@get-bb/plugin-sdk": "0.6.132",
    "@modelcontextprotocol/sdk": "^1.32.2",
    "@radix-ui/react-checkbox": "^1.4.1",
    "@radix-ui/react-slot": "^1.5.0",
    "zod": "^4.6.5"
  },
  "devDependencies": {
    "@types/better-sqlite3": "^7.6.12",
    "@types/node": "^22.0.0",
    "@types/react": "^19.0.0",
    "@types/react-dom": "^19.0.0",
    "better-sqlite3": "^12.0.0",
    "cron-parser": "^5.5.0",
    "hono": "^4.11.9",
    "typescript": "^5.7.0",
    "vitest": "^4.0.0",
    "@pierre/diffs": "~1.2.12",
    "@radix-ui/react-alert-dialog": "^1.2.1",
    "@radix-ui/react-context-menu": "^2.4.1",
    "@radix-ui/react-dialog": "^1.3.1",
    "@radix-ui/react-dropdown-menu": "^2.2.1",
    "@radix-ui/react-hover-card": "^1.2.1",
    "@radix-ui/react-menubar": "^1.2.1",
    "@radix-ui/react-navigation-menu": "^1.4.1",
    "@radix-ui/react-popover": "^1.3.1",
    "@radix-ui/react-select": "^2.4.1",
    "@radix-ui/react-tooltip": "^1.4.1",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "sonner": "^1.7.4",
    "tailwind-merge": "^3.7.0",
    "vaul": "^1.1.2"
  }
}
